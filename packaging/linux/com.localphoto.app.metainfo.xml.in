<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.localphoto.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Local Photo</name>
  <summary>Organise photos and develop raw files, non-destructively</summary>
  <developer id="com.localphoto">
    <name>Local Photo contributors</name>
  </developer>
  <description>
    <p>
      Local Photo is a photo library and raw developer. Organise photos and develop raw files, non-destructively
    </p>
  </description>
  <launchable type="desktop-id">com.localphoto.app.desktop</launchable>
  <icon type="stock">com.localphoto.app</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/Local-Photo</url>
  <url type="bugtracker">https://github.com/Anon5T4R/Local-Photo/issues</url>
  <url type="help">https://github.com/Anon5T4R/Local-Photo</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Photo editing with The Tetons and the Snake River by Ansel Adams</caption>
      <image type="source">https://raw.githubusercontent.com/Anon5T4R/Local-Photo/3b4279fc2485bb51847c0071a1b3c514aa0f98f4/docs/images/hero-tetons.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>localphoto</binary>
    <mediatype>image/heic</mediatype>
    <mediatype>image/heif</mediatype>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/tiff</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/x-adobe-dng</mediatype>
    <mediatype>image/x-sony-arw</mediatype>
    <mediatype>image/x-canon-cr2</mediatype>
    <mediatype>image/x-canon-cr3</mediatype>
    <mediatype>image/x-nikon-nef</mediatype>
    <mediatype>image/x-fuji-raf</mediatype>
    <mediatype>image/x-olympus-orf</mediatype>
    <mediatype>image/x-panasonic-rw2</mediatype>
    <mediatype>image/x-panasonic-rw</mediatype>
    <mediatype>image/x-pentax-pef</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
