<?xml version="1.0" encoding="utf-8"?>
<!--
  Local Photo MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build localphoto.wxs -arch x64 -ext WixToolset.UI.wixext/5.0.2 -ext WixToolset.Util.wixext/5.0.2
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d UiDialogBmp=... -d UiBannerBmp=... -o out.msi

  Per-machine install into Program Files (or the folder chosen in the installer, or
  `INSTALLFOLDER=...` on the msiexec command line; upgrades keep it), a Start Menu shortcut and a desktop shortcut, and
  Local Photo offered under "Open with" for the formats it reads (without taking over the user's
  default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Local Photo"
      Manufacturer="Local Photo contributors"
      Version="$(var.Version)"
      UpgradeCode="8D094861-CAE1-46F8-A1D4-5AE9741070AA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Local Photo photo library and raw developer" Manufacturer="Local Photo contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Local Photo is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LocalPhotoIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LocalPhotoIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Anon5T4R/Local-Photo" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Anon5T4R/Local-Photo" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Anon5T4R/Local-Photo/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Local Photo" />
    </StandardDirectory>
    <!-- The folder of the installed version (written by LocalPhotoApp), so an upgrade installs
         where the user chose instead of moving back to Program Files (issue #399). Searched into
         its own property: AppSearch would otherwise overwrite INSTALLFOLDER=... given to msiexec. -->
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Local Photo" Name="InstallFolder" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both"
        Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <!-- Older MSIs (including 0.5.0) only recorded the executable in App Paths. Type="file"
         without a FileSearch returns its containing directory. Keep the searches separate so
         the newer InstallFolder value and an explicit INSTALLFOLDER always take precedence. -->
    <Property Id="LEGACYINSTALLFOLDER">
      <RegistrySearch Id="LegacyInstallFolder" Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localphoto.exe" Type="file" />
    </Property>
    <!-- That directory search doesn't check the executable exists, and when its unquoted path is
         gone it falls back to the text before the first space: a deleted
         "C:\Program Files\Local Photo\localphoto.exe" yields "C:\". Only use the folder when this
         search, which does require localphoto.exe, finds it too. -->
    <Property Id="LEGACYINSTALLEXE">
      <RegistrySearch Id="LegacyInstallExe" Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localphoto.exe" Type="file">
        <FileSearch Id="LegacyInstallExeFile" Name="localphoto.exe" />
      </RegistrySearch>
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderFromAppPaths" Value="[LEGACYINSTALLFOLDER]"
        After="SetINSTALLFOLDER" Sequence="both"
        Condition="LEGACYINSTALLFOLDER AND LEGACYINSTALLEXE AND NOT PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Local Photo" Level="1">
      <ComponentGroupRef Id="LocalPhotoFiles" />
    </Feature>

    <UIRef Id="LocalPhotoUI" />
  </Package>

  <!--
    Interactive install UI: Welcome -> Destination Folder -> Ready to install -> progress ->
    "Completed" (Finish), with a "Launch Local Photo" checkbox (checked by default). Destination
    Folder (issue #399) shows Program Files\Local Photo, or the installed version's folder on an
    upgrade; Change... browses, and a folder that can't be used (InvalidDirDlg) is refused before
    anything is installed. Failure and cancellation end on WiX's standard FatalError / UserExit
    dialogs instead of the completion page. Maintenance (running the MSI again, Repair/Remove from
    Apps) uses the standard maintenance dialogs; every successful run — install, repair or
    remove — then ends on the shared completion page, so a successful uninstall is confirmed
    with a visible final dialog (issue #892; the page itself is issue #790's fix).

    This is WixUI_InstallDir without its licence-acceptance page: Local Photo is MIT OR Apache-2.0,
    which ask nothing of people who just install and run it, so a click-through EULA would only
    add a step. Silent (/qn) and basic-UI (/passive, /qb) installs never show these dialogs, so
    they are unaffected, and nothing is launched.

    The dialogs, strings and error/cancel pages come from WixToolset.UI.wixext; the side and
    banner bitmaps are plain panels generated by package.ps1 (no third-party artwork).
  -->
  <Fragment>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.UiDialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.UiBannerBmp)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
        Value="Local Photo has been installed. You can start it at any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Local Photo" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- "Launch Local Photo" on Finish. WixUnelevatedShellExec (Util extension) asks the desktop
         shell (Explorer) to start the program, so it runs as the signed-in user at normal
         integrity even when the installer UI itself is elevated (e.g. msiexec started from an
         admin prompt); it never runs from the elevated/SYSTEM server side. It is a UI-only control
         event, so silent and passive installs never run it. Return="ignore": a failed launch must
         not turn a successful install into an error. -->
    <Property Id="WixUnelevatedShellExecTarget" Value="[#LocalPhotoExe]" />
    <CustomAction Id="LaunchLocalPhoto" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixUnelevatedShellExec" Execute="immediate" Impersonate="yes" Return="ignore" />

    <UI Id="LocalPhotoUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="DiskCostDlg" />
      <!-- Referenced by the Publish events below but never pulled in on its own: without this
           ref the MSI ships without a completion page, so a successful install or remove ends
           silently (issues #790, #892). The UI extension's fragment shows it on exit=success,
           which covers Remove from Apps & features too. -->
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <!-- The folder InstallDirDlg edits. -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <!-- First install / upgrade: Welcome -> Destination Folder -> Ready to install. A patch skips
           the folder (it can't move an installed product). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <!-- Destination Folder, as in WixUI_InstallDir: Next sets the folder, validates it (WiX's
           WixUIValidatePath) and refuses one that can't be used; Change... opens the folder browser,
           whose OK validates too. -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="2"
          Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"
          Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4"
          Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="3"
          Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"
          Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1"
          Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3"
          Condition="Installed AND PATCH" />

      <!-- Maintenance: Welcome -> Repair / Remove -> Ready. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2"
          Condition="Installed AND NOT PATCH" />

      <!-- Completion page: optionally launch, then close. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLocalPhoto" Order="1"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <!-- One feature, nothing to change: no "Change" in Apps & features. -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="LocalPhotoFiles" Directory="INSTALLFOLDER">
      <Component Id="LocalPhotoApp" Guid="8A1D3A39-F7C1-47B1-97AE-40C80BF82F4A">
        <File Id="LocalPhotoExe" Source="$(var.BinDir)\localphoto.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Local Photo"
              Description="Local Photo photo library and raw developer" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LocalPhotoIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localphoto.exe" Value="[#LocalPhotoExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Local Photo" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" />
        <!-- Suite convention (craft-update's `install_dir`): `InstallDir` under the app's own key. -->
        <RegistryValue Root="HKLM" Key="Software\Local Photo" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Anon5T4R\LocalPhoto" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />

        <!-- "Open with" and Settings > Default apps, through the Default Programs registration (ProgID,
             OpenWithProgids, Capabilities, RegisteredApplications). Same extensions as the Linux desktop entry's MimeType.
             Never takes over an extension: the default value is left alone and the user chooses. -->
        <ProgId Id="LocalPhoto.Image" Description="Photo" Icon="LocalPhotoExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LocalPhoto.Image\shell\open\command" Value="&quot;[#LocalPhotoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.heic\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.heif\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dng\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.arw\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.cr2\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.cr3\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.nef\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.raf\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.orf\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rw2\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes.rawOpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pef\OpenWithProgids" Name="LocalPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe" Name="FriendlyAppName" Value="Local Photo" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\shell\open\command" Value="&quot;[#LocalPhotoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".heic" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".heif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".dng" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".arw" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".cr2" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".cr3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".nef" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".raf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".orf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".rw2" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".raw" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\localphoto.exe\SupportedTypes" Name=".pef" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities" Name="ApplicationName" Value="Local Photo" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities" Name="ApplicationDescription" Value="Photo library and raw developer" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities" Name="ApplicationIcon" Value="[#LocalPhotoExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".heic" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".heif" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".jpg" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".jpeg" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".png" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".tif" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".tiff" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".webp" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".dng" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".arw" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".cr2" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".cr3" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".nef" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".raf" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".orf" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".rw2" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".raw" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LocalPhoto\Capabilities\FileAssociations" Name=".pef" Value="LocalPhoto.Image" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="LocalPhoto" Value="Software\LocalPhoto\Capabilities" Type="string" />
      </Component>

      <Component Id="LocalPhotoCli">
        <File Id="LocalPhotoCliExe" Source="$(var.BinDir)\localphoto-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Desktop shortcut, the suite's standard: a plain shortcut (not advertised, so it works
           from the desktop without fetching the MSI on first launch) with its own component and
           registry key path, so an uninstall removes it. -->
      <Component Id="LocalPhotoDesktopShortcut" Directory="DesktopFolder" Guid="4A2EC395-DB77-4B75-BDAB-2FA4861E26C8">
        <Shortcut Id="DesktopShortcut" Name="Local Photo" Description="Local Photo photo library and raw developer"
            Target="[#LocalPhotoExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalPhotoIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Local Photo\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LocalPhotoNotice">
        <File Id="LocalPhotoNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="LocalPhotoFontLicences">
        <File Id="LocalPhotoFontLicencesFile" Source="$(var.BinDir)\FONT-LICENCES.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
